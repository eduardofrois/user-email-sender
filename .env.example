# Application images
# In CI/CD, replace these values with images pushed to your registry.
USER_SERVICE_IMAGE=user-mail/user-service:local
EMAIL_SERVICE_IMAGE=user-mail/email-service:local

# Public ports exposed by the VPS
USER_SERVICE_PORT=8081
EMAIL_SERVICE_PORT=8080

# Infrastructure ports are bound to localhost by default.
# Keep this pattern on a VPS unless you explicitly need remote access.
POSTGRES_PORT=127.0.0.1:5432
RABBITMQ_PORT=127.0.0.1:5672
RABBITMQ_MANAGEMENT_PORT=127.0.0.1:15672

# PostgreSQL
# One database is used with two isolated schemas.
POSTGRES_DB=user_mail_sender
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-admin-password

USER_DB_SCHEMA=user_service
USER_DB_USERNAME=user_service_app
USER_DB_PASSWORD=change-me-user-service-password

EMAIL_DB_SCHEMA=email_service
EMAIL_DB_USERNAME=email_service_app
EMAIL_DB_PASSWORD=change-me-email-service-password

# RabbitMQ
RABBITMQ_USERNAME=app_rabbitmq
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VIRTUAL_HOST=/

EMAIL_QUEUE=email-queue
EMAIL_DLQ=email-dlq
EMAIL_DLX=email-dlx
SIMULATED_DELAY_QUEUE=simulated-delay-queue

# Email retry
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_INITIAL_INTERVAL=2000
EMAIL_RETRY_MULTIPLIER=2.0
EMAIL_RETRY_MAX_INTERVAL=10000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=change-me@example.com
SMTP_PASSWORD=change-me-smtp-password

# JVM options
USER_SERVICE_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
EMAIL_SERVICE_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
